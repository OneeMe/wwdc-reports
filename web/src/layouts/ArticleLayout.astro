---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  thumbnail?: string;
  videoUrl?: string;
}

const { title, description, date, tags, thumbnail, videoUrl } = Astro.props;

const formattedDate = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <article class="article-container">
    {thumbnail && (
      <div class="article-thumbnail">
        <img src={thumbnail} alt={title} loading="eager" />
      </div>
    )}
    <header class="article-header">
      <h1 class="article-title">{title}</h1>
      <div class="article-meta">
        <time datetime={date.toISOString()} class="article-date">{formattedDate}</time>
        <div class="article-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
      {videoUrl && (
        <a class="video-link-button" href={videoUrl} target="_blank" rel="noopener noreferrer">
          <span class="video-link-icon" aria-hidden="true">▶</span>
          <span>观看原视频</span>
        </a>
      )}
    </header>

    <div class="article-content">
      <slot />
    </div>
  </article>

  <style is:global>
    /* Article layout */
    .article-container {
      max-width: 780px;
      margin: 0 auto;
      padding: 48px 24px 64px;
    }

    .article-thumbnail {
      margin: 0 0 32px;
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 16 / 9;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .article-thumbnail img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .article-header {
      margin-bottom: 40px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--line);
    }

    .article-title {
      margin: 0 0 20px;
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.25;
      color: var(--ink);
      letter-spacing: -0.01em;
    }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }

    .article-date {
      font-size: 0.9rem;
      color: var(--slate);
      font-weight: 500;
    }

    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 8px;
      background: rgba(39, 130, 251, 0.1);
      color: var(--blue);
      font-size: 0.8rem;
      font-weight: 600;
    }

    .video-link-button {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-top: 24px;
      padding: 11px 16px 11px 12px;
      border-radius: 999px;
      background: var(--ink);
      color: white;
      font-size: 0.92rem;
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
      box-shadow: 0 10px 24px rgba(11, 11, 15, 0.16);
      transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
    }

    .video-link-button:hover {
      transform: translateY(-1px);
      background: var(--blue);
      box-shadow: 0 14px 28px rgba(39, 130, 251, 0.22);
    }

    .video-link-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      font-size: 0.72rem;
      line-height: 1;
    }

    /* Typography */
    .article-content {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--ink);
    }

    .article-content h1 {
      font-size: 1.8rem;
      font-weight: 750;
      margin: 48px 0 20px;
      line-height: 1.3;
    }

    .article-content h2 {
      font-size: 1.45rem;
      font-weight: 700;
      margin: 40px 0 16px;
      line-height: 1.35;
      color: var(--ink);
    }

    .article-content h3 {
      font-size: 1.2rem;
      font-weight: 680;
      margin: 32px 0 12px;
      line-height: 1.4;
      color: var(--ink);
    }

    .article-content p {
      margin: 0 0 18px;
    }

    .article-content ul,
    .article-content ol {
      margin: 0 0 20px;
      padding-left: 24px;
    }

    .article-content li {
      margin: 8px 0;
    }

    .article-content a {
      color: var(--blue);
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 150ms ease;
    }

    .article-content a:hover {
      opacity: 0.8;
    }

    /* Code blocks */
    .article-content pre {
      margin: 24px 0;
      padding: 20px 24px;
      border-radius: 14px;
      background: #1a1a2e;
      overflow-x: auto;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .article-content pre code {
      background: none;
      padding: 0;
      color: #e4e4e7;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    }

    .article-content code {
      background: rgba(11, 11, 15, 0.06);
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 0.88em;
      font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
      color: var(--ink);
    }

    /* Tables */
    .article-content table {
      width: 100%;
      margin: 24px 0;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    .article-content th,
    .article-content td {
      padding: 12px 16px;
      text-align: left;
      border: 1px solid var(--line);
    }

    .article-content th {
      background: rgba(11, 11, 15, 0.04);
      font-weight: 650;
      color: var(--ink);
    }

    .article-content tr:nth-child(even) {
      background: rgba(11, 11, 15, 0.02);
    }

    /* Blockquotes */
    .article-content blockquote {
      margin: 24px 0;
      padding: 20px 24px;
      border-left: 4px solid var(--orange);
      border-radius: 0 12px 12px 0;
      background: rgba(251, 97, 49, 0.06);
      font-style: normal;
    }

    .article-content blockquote p {
      margin: 0;
      color: var(--ink);
      font-weight: 500;
    }

    /* Horizontal rules */
    .article-content hr {
      margin: 36px 0;
      border: none;
      height: 1px;
      background: var(--line);
    }

    /* Strong and emphasis */
    .article-content strong {
      font-weight: 650;
      color: var(--ink);
    }

    /* Responsive */
    @media (max-width: 640px) {
      .article-container {
        padding: 32px 16px 48px;
      }

      .article-title {
        font-size: 1.6rem;
      }

      .article-content {
        font-size: 1rem;
      }

      .article-content pre {
        padding: 16px;
        border-radius: 12px;
        font-size: 0.85rem;
      }
    }
  </style>
</BaseLayout>
