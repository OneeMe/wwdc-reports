---
import LangSwitcher from "../components/LangSwitcher.astro";
import { googleAdsenseConfig } from "../config/adsense";
import { localeData } from "../i18n/landing";
import {
  defaultLang,
  getHtmlLang,
  getLangFromPath,
  getLocalizedPath,
  stripLangPrefix,
  supportedLangs,
} from "../i18n/routing";
import type { LangCode } from "../i18n/routing";
import { normalizeMetaDescription } from "../seo";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  lang?: LangCode;
  section?: "home" | "articles";
}

const defaultSocialImages: Record<LangCode, string> = {
  zh: "/assets/wwdc-quick-look-social-zh.png",
  en: "/assets/wwdc-quick-look-social-en.png",
  ja: "/assets/wwdc-quick-look-social-ja.png",
};
const {
  title,
  description,
  image,
  imageAlt = title,
  type = "website",
  publishedTime,
  tags = [],
  noindex = false,
  lang: propLang,
  section,
} = Astro.props;
const lang = propLang ?? getLangFromPath(Astro.url.pathname);
const resolvedImage = image ?? defaultSocialImages[lang];
const layoutCopy = localeData[lang] ?? localeData[defaultLang];
const currentPath = stripLangPrefix(Astro.url.pathname);
const isArticlesPage =
  section === "articles" ||
  (section !== "home" && (currentPath === "/articles" || currentPath.startsWith("/articles/")));
const homeHref = getLocalizedPath("/", lang);
const articlesHref = getLocalizedPath("/articles", lang);
const brandHref = isArticlesPage ? articlesHref : homeHref;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const openGraphLocales: Record<LangCode, string> = {
  zh: "zh_CN",
  en: "en_US",
  ja: "ja_JP",
};

function withTrailingSlash(pathname: string): string {
  const normalized = pathname.replace(/\/+$/, "") || "/";
  return normalized === "/" ? normalized : `${normalized}/`;
}

const canonicalUrl = new URL(withTrailingSlash(Astro.url.pathname), siteBase).toString();
const metaDescription = normalizeMetaDescription(description, layoutCopy.description);
const socialImageUrl = new URL(resolvedImage, siteBase).toString();
const socialImagePath = new URL(socialImageUrl).pathname.toLowerCase();
const socialImageType = socialImagePath.endsWith(".png")
  ? "image/png"
  : socialImagePath.endsWith(".jpg") || socialImagePath.endsWith(".jpeg")
    ? "image/jpeg"
    : undefined;
const usesDefaultSocialImage = image == null;
const googleAnalyticsId =
  import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID ?? import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const alternateLinks = supportedLangs.map((code) => ({
  code,
  hrefLang: getHtmlLang(code),
  href: new URL(withTrailingSlash(getLocalizedPath(currentPath, code)), siteBase).toString(),
}));
const xDefaultHref = new URL(
  withTrailingSlash(getLocalizedPath(currentPath, defaultLang)),
  siteBase,
).toString();
---

<!doctype html>
<html lang={getHtmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="icon"
      href="/assets/wwdc-quick-look-favicon-32.png"
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="shortcut icon"
      href="/assets/wwdc-quick-look-favicon-32.png"
      type="image/png"
    />
    <link
      rel="apple-touch-icon"
      href="/assets/wwdc-quick-look-apple-touch-icon-180.png"
      sizes="180x180"
    />
    <meta name="description" content={metaDescription} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"}
    />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="sitemap" href="/sitemap.xml" />

        <meta property="og:type" content={type} />
        <meta property="og:site_name" content="WWDC Quick Look" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:locale" content={openGraphLocales[lang]} />
        {supportedLangs.filter((code) => code !== lang).map((code) => (
          <meta property="og:locale:alternate" content={openGraphLocales[code]} />
        ))}
        <meta property="og:image" content={socialImageUrl} />
        {socialImageType && <meta property="og:image:type" content={socialImageType} />}
        {usesDefaultSocialImage && (
          <>
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
          </>
        )}
        <meta property="og:image:alt" content={imageAlt} />
        {type === "article" && publishedTime && (
          <meta property="article:published_time" content={publishedTime.toISOString()} />
        )}
        {type === "article" && tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={socialImageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    {!noindex && (
      <>
        {alternateLinks.map((link) => (
          <link rel="alternate" hreflang={link.hrefLang} href={link.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      </>
    )}
    {googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
        <script define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", googleAnalyticsId);
        </script>
      </>
    )}
    {googleAdsenseConfig.enabled && (
      <script
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${googleAdsenseConfig.client}`}
      ></script>
    )}
    <style>
      :root {
        color-scheme: light;
        --blue: #2782fb;
        --orange: #fb6131;
        --ink: #0b0b0f;
        --slate: #737682;
        --mist: #f5f6f8;
        --paper: #ffffff;
        --line: #e4e7ee;
        --line-strong: #ced5e2;
        --shadow: 0 28px 80px rgba(11, 11, 15, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--paper);
        scroll-behavior: smooth;
      }

      body {
        min-width: 320px;
        margin: 0;
        color: var(--ink);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "SF Pro Display",
          "PingFang SC",
          "Hiragino Sans GB",
          "Yu Gothic",
          sans-serif;
        letter-spacing: 0;
        background:
          radial-gradient(circle at 18% 11%, rgba(251, 97, 49, 0.16), transparent 24rem),
          radial-gradient(circle at 67% 8%, rgba(39, 130, 251, 0.16), transparent 30rem),
          linear-gradient(180deg, #fff 0%, #fbfcff 54%, #f6f8fb 100%);
      }

      a {
        color: inherit;
      }

      .page {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
        padding: 18px 0 80px;
      }

      .top-bar {
        position: sticky;
        top: 14px;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 64px;
        padding: 10px 12px;
        border: 1px solid rgba(228, 231, 238, 0.92);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.86);
        box-shadow: 0 16px 42px rgba(11, 11, 15, 0.08);
        backdrop-filter: blur(18px);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: inherit;
        text-decoration: none;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .brand-title {
        font-size: 0.95rem;
        font-weight: 760;
        line-height: 1.2;
      }

      .brand-subtitle {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--slate);
        line-height: 1.2;
      }

      .bird-mark {
        display: block;
        width: 42px;
        height: auto;
        flex: 0 0 auto;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-right: 8px;
      }

      .nav-links a {
        padding: 6px 14px;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 640;
        color: var(--slate);
        text-decoration: none;
        transition: color 160ms ease, background 160ms ease;
      }

      .nav-links a:hover {
        color: var(--ink);
        background: rgba(11, 11, 15, 0.04);
      }

      .nav-links a.active {
        color: var(--ink);
        background: rgba(11, 11, 15, 0.06);
      }

      .site-footer {
        display: grid;
        grid-template-columns: minmax(280px, 0.85fr) minmax(420px, 1.15fr);
        column-gap: 72px;
        row-gap: 10px;
        align-items: flex-start;
        margin-top: 58px;
        padding: 32px 42px 20px;
        border: 1px solid rgba(228, 231, 238, 0.92);
        border-radius: 26px;
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 18px 52px rgba(11, 11, 15, 0.06);
      }

      .footer-about {
        min-width: 0;
      }

      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #252a33;
        font-size: 1.22rem;
        font-weight: 760;
        text-decoration: none;
      }

      .footer-mark {
        width: 28px;
        height: auto;
        flex: 0 0 auto;
      }

      .footer-copy {
        max-width: 440px;
        margin: 14px 0 0;
        color: #9a9ca3;
        font-size: 0.98rem;
        font-weight: 650;
        line-height: 1.45;
      }

      .footer-nav {
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 44px;
      }

      .footer-column {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }

      .footer-heading {
        margin: 0 0 2px;
        color: #303642;
        font-size: 1rem;
        font-weight: 760;
      }

      .footer-column a {
        color: #9a9ca3;
        font-size: 1rem;
        font-weight: 650;
        line-height: 1.1;
        text-decoration: none;
        transition: color 160ms ease;
      }

      .footer-column a:hover {
        color: var(--ink);
      }

      @media (prefers-reduced-motion: no-preference) {
        .hero-copy,
        .hero-art,
        .prompt-panel {
          animation: rise-in 640ms ease both;
        }

        .hero-art {
          animation-delay: 90ms;
        }

        .prompt-panel {
          animation-delay: 150ms;
        }

        @keyframes rise-in {
          from {
            opacity: 0;
            transform: translateY(16px);
          }

          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }

      @media (max-width: 980px) {
        .site-footer {
          grid-template-columns: 1fr;
        }

        .footer-nav {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 22px;
        }
      }

      @media (max-width: 640px) {
        .page {
          width: calc(100% - 24px);
          padding-top: 10px;
        }

        .top-bar {
          position: static;
          align-items: flex-start;
          flex-direction: column;
          border-radius: 18px;
          padding: 10px;
        }

        .nav-actions {
          width: 100%;
        }

        .site-footer {
          gap: 28px;
          padding: 24px;
          border-radius: 22px;
        }

        .footer-nav {
          grid-template-columns: 1fr;
          gap: 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="top-bar">
        <a href={brandHref} class="brand" aria-label="WWDC Quick Look">
          <img class="bird-mark" src="/assets/swiftgg-mark-color.svg" alt="" aria-hidden="true" />
          <div class="brand-text">
            <span class="brand-title">WWDC Quick Look</span>
            <span class="brand-subtitle">💓 By SwiftGGTeam</span>
          </div>
        </a>
        <div class="nav-actions">
          <nav class="nav-links" aria-label={layoutCopy.navAriaLabel}>
            <a href={homeHref} class={currentPath === "/" ? "active" : ""}>{layoutCopy.navHome}</a>
            <a href={articlesHref} class={isArticlesPage ? "active" : ""}>{layoutCopy.navArticles}</a>
          </nav>
          <LangSwitcher lang={lang} pathname={Astro.url.pathname} search={Astro.url.search} label={layoutCopy.languageSwitcherLabel} />
        </div>
      </header>

      <slot />

      <footer class="site-footer">
        <div class="footer-about">
          <a class="footer-brand" href="https://swiftgg.team/" target="_blank" rel="noreferrer" aria-label="SwiftGG">
            <img class="footer-mark" src="/assets/swiftgg-mark-color.svg" alt="" aria-hidden="true" />
            <span>SwiftGG</span>
          </a>
          <p class="footer-copy">{layoutCopy.footerCopy}</p>
        </div>
        <nav class="footer-nav" aria-label={layoutCopy.footerTeamHeading}>
          <div class="footer-column">
            <h2 class="footer-heading">{layoutCopy.footerTeamHeading}</h2>
            <a href="https://swiftgg.team/#services" target="_blank" rel="noreferrer">{layoutCopy.footerAboutLink}</a>
            <a href="https://swiftgg.team/terms" target="_blank" rel="noreferrer">{layoutCopy.footerTermsLink}</a>
            <a href="https://swiftgg.team/privacy" target="_blank" rel="noreferrer">{layoutCopy.footerPrivacyLink}</a>
          </div>
          <div class="footer-column">
            <h2 class="footer-heading">{layoutCopy.footerActivitiesHeading}</h2>
            <a href="https://swiftgg.team/letsvision" target="_blank" rel="noreferrer">LET'S VISION</a>
            <a href="https://swiftgg.team/wwdc" target="_blank" rel="noreferrer">WWDC Playground</a>
            <a href="https://swiftgg.team/atswift" target="_blank" rel="noreferrer">@Swift</a>
          </div>
          <div class="footer-column">
            <h2 class="footer-heading">{layoutCopy.footerTranslationHeading}</h2>
            <a href="https://swift.swiftgg.team/" target="_blank" rel="noreferrer">{layoutCopy.footerChineseSiteLink}</a>
            <a href="https://doc.swiftgg.team/documentation/the-swift-programming-language" target="_blank" rel="noreferrer">TSPL</a>
          </div>
        </nav>
      </footer>
    </main>
  </body>
</html>
