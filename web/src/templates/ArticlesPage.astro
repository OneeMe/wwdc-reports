---
import BaseLayout from "../layouts/BaseLayout.astro";
import SessionBrowser from "../components/SessionBrowser.astro";
import { getArticlesLocale } from "../i18n/articles";
import type { LangCode } from "../i18n/routing";

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const copy = getArticlesLocale(lang);
---

<BaseLayout
  title={copy.documentTitle}
  description={copy.documentDescription}
  lang={lang}
  section="articles"
>
  <div class="session-browser-wrapper">
    <SessionBrowser lang={lang} />
  </div>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 18% 11%, rgba(251, 97, 49, 0.14), transparent 24rem),
      radial-gradient(circle at 82% 20%, rgba(39, 130, 251, 0.12), transparent 28rem),
      linear-gradient(180deg, #fff 0%, #fbfcff 50%, #f6f8fb 100%);
    min-height: 100vh;
  }
  .session-browser-wrapper {
    margin: 0;
    padding: 0;
  }
</style>
