---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localeData } from "../i18n/landing";
import type { LangCode } from "../i18n/routing";

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const data = localeData[lang];
---

<BaseLayout
  title={data.documentTitle}
  description={data.description}
  lang={lang}
  section="home"
>
  <section class="hero" aria-labelledby="pageTitle">
    <div class="hero-copy">
      <p class="kicker">{data.kicker}</p>
      <h1 class="title" id="pageTitle" aria-label={data.title}>
        <span class="title-line title-line-primary">wwdc</span>
        <span class="title-line title-line-secondary">quick look</span>
      </h1>
      <p class="subtitle">{data.subtitle}</p>

      <div class="hero-actions">
        <a class="button button-star" href="https://github.com/SwiftGGTeam/wwdc-quick-look" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path fill="currentColor" d="M8 .25a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.36c-2.23.49-2.7-.95-2.7-.95-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.22.83 1.22.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.58.82-2.14-.08-.2-.36-1.02.08-2.11 0 0 .67-.22 2.2.82A7.66 7.66 0 0 1 8 4.78c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.09.16 1.91.08 2.11.51.56.82 1.27.82 2.14 0 3.07-1.87 3.75-3.66 3.95.29.25.54.74.54 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 .25Z" />
          </svg>
          <span>{data.githubStar}</span>
        </a>
      </div>

      <div class="install-card" aria-label={data.installStep}>
        <div class="install-label">{data.installStep}</div>
        <code class="code">{data.installCmd}</code>
      </div>
    </div>

    <div class="hero-art" aria-label={data.heroArtLabel}>
      <div class="art-wordmark" aria-hidden="true">
        <span>wwdc</span>
        <span>quick look</span>
      </div>
      <img class="art-bird" src="/assets/swiftgg-mark-color.svg" alt="" aria-hidden="true" />
      <div class="art-command">
        <p class="art-command-label">{data.artCommandLabel}</p>
        <code class="code">{data.installCmd}</code>
      </div>
      <div class="art-card-grid" aria-hidden="true">
        <div class="art-card">
          <strong>{data.artCardSearchTitle}</strong>
          <span>{data.artCardSearchText}</span>
        </div>
        <div class="art-card">
          <strong>{data.artCardResourceTitle}</strong>
          <span>{data.artCardResourceText}</span>
        </div>
        <div class="art-card">
          <strong>{data.artCardEvidenceTitle}</strong>
          <span>{data.artCardEvidenceText}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="prompt-panel" aria-labelledby="promptTitle">
    <div class="panel-head">
      <div>
        <p class="section-label">{data.promptLabel}</p>
        <h2 class="section-title" id="promptTitle">{data.promptTitle}</h2>
      </div>
      <p class="muted">{data.promptIntro}</p>
    </div>
    <ol class="prompt-list">
      {data.prompts.map((prompt) => (
        <li class="prompt-item">
          <p class="prompt-label">{prompt.label}</p>
          <code class="code">{prompt.text}</code>
        </li>
      ))}
    </ol>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
      gap: 54px;
      align-items: center;
      min-height: calc(100vh - 88px);
      padding: 70px 0 58px;
    }

    .kicker {
      margin: 0 0 20px;
      color: var(--blue);
      font-size: 0.82rem;
      font-weight: 820;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .title {
      display: grid;
      gap: 0.02em;
      max-width: 680px;
      margin: 0;
      font-family: "Avenir Next", "SF Pro Rounded", "SF Pro Display", "PingFang SC", sans-serif;
      font-size: clamp(5.5rem, 9vw, 7.1rem);
      line-height: 0.86;
      font-weight: 900;
      letter-spacing: 0;
      text-rendering: geometricPrecision;
    }

    .title-line {
      display: block;
      white-space: nowrap;
    }

    .title-line-primary {
      position: relative;
      width: max-content;
    }

    .title-line-primary::after {
      display: none;
      content: none;
    }

    .title-line-secondary {
      font-size: 0.84em;
    }

    .subtitle {
      max-width: 650px;
      margin: 30px 0 0;
      color: #343842;
      font-size: 1.18rem;
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 50px;
      padding: 0 18px;
      border: 1px solid var(--ink);
      border-radius: 10px;
      color: var(--ink);
      background: var(--paper);
      font-weight: 760;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .button:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(11, 11, 15, 0.1);
    }

    .button-star {
      color: var(--paper);
      background: var(--ink);
    }

    .button-star svg {
      width: 20px;
      height: 20px;
    }

    .install-card {
      display: grid;
      gap: 10px;
      max-width: 690px;
      margin-top: 28px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 16px 48px rgba(39, 130, 251, 0.09);
    }

    .install-label,
    .art-command-label,
    .section-label,
    .prompt-label {
      margin: 0;
      font-size: 0.78rem;
      font-weight: 840;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .install-label,
    .section-label {
      color: var(--blue);
    }

    .art-command-label,
    .prompt-label {
      color: var(--orange);
    }

    .code {
      display: block;
      min-width: 0;
      margin: 0;
      padding: 15px 16px;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: #151922;
      background: #f8faff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.95rem;
      line-height: 1.55;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .hero-art {
      position: relative;
      min-height: 560px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 28px;
      background:
        radial-gradient(circle at 18% 22%, rgba(251, 97, 49, 0.22), transparent 12rem),
        radial-gradient(circle at 68% 18%, rgba(39, 130, 251, 0.24), transparent 16rem),
        linear-gradient(135deg, #fff 0%, #f5f8ff 58%, #fff7f3 100%);
      box-shadow: var(--shadow);
    }

    .hero-art::before {
      position: absolute;
      inset: 26px;
      content: "";
      border: 1px solid rgba(11, 11, 15, 0.08);
      border-radius: 22px;
    }

    .art-wordmark {
      position: absolute;
      top: 52px;
      left: 44px;
      right: 150px;
      display: grid;
      gap: 0.01em;
      font-family: "Avenir Next", "SF Pro Rounded", "SF Pro Display", "PingFang SC", sans-serif;
      font-size: clamp(3.2rem, 5.6vw, 4.6rem);
      line-height: 0.86;
      font-weight: 900;
      letter-spacing: 0;
      text-rendering: geometricPrecision;
    }

    .art-wordmark span {
      display: block;
      white-space: nowrap;
    }

    .art-wordmark span:first-child {
      color: var(--blue);
    }

    .art-wordmark span:last-child {
      color: var(--orange);
    }

    .art-bird {
      position: absolute;
      right: 42px;
      top: 64px;
      width: 80px;
      height: auto;
      filter: drop-shadow(0 14px 28px rgba(39, 130, 251, 0.16));
    }

    .art-command {
      position: absolute;
      left: 44px;
      right: 44px;
      top: 248px;
      padding: 20px;
      border: 1px solid rgba(11, 11, 15, 0.1);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.76);
      box-shadow: 0 20px 50px rgba(11, 11, 15, 0.08);
    }

    .art-command-label {
      margin-bottom: 10px;
    }

    .art-card-grid {
      position: absolute;
      left: 44px;
      right: 44px;
      bottom: 44px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .art-card {
      min-height: 104px;
      padding: 16px;
      border: 1px solid rgba(11, 11, 15, 0.09);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.64);
    }

    .art-card strong {
      display: block;
      margin-bottom: 8px;
      font-size: 0.92rem;
    }

    .art-card span {
      color: var(--slate);
      font-size: 0.84rem;
      line-height: 1.48;
    }

    .prompt-panel {
      border-top: 1px solid var(--line);
      padding-top: 54px;
    }

    .panel-head {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(280px, 1fr);
      gap: 44px;
      align-items: end;
    }

    .section-label {
      margin-bottom: 14px;
    }

    .section-title {
      margin: 0;
      font-size: clamp(2.6rem, 5vw, 4.6rem);
      line-height: 0.92;
      font-weight: 900;
    }

    .muted {
      margin: 0;
      color: #3d424d;
      font-size: 1.04rem;
      line-height: 1.72;
    }

    .prompt-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin: 32px 0 0;
      padding: 0;
      list-style: none;
    }

    .prompt-item {
      min-width: 0;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--paper);
      box-shadow: 0 14px 38px rgba(11, 11, 15, 0.06);
    }

    .prompt-label {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      margin-bottom: 14px;
    }

    .prompt-item .code {
      min-height: 164px;
    }

    @media (max-width: 980px) {
      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-art {
        min-height: 520px;
      }

      .title {
        font-size: 7.1rem;
      }

      .art-wordmark {
        font-size: 4.6rem;
      }

      .panel-head,
      .prompt-list {
        grid-template-columns: 1fr;
      }

      .prompt-item .code {
        min-height: auto;
      }
    }

    @media (max-width: 640px) {
      .hero {
        gap: 34px;
        padding-top: 40px;
      }

      .title {
        font-size: 4.2rem;
      }

      .hero-actions,
      .button {
        width: 100%;
      }

      .hero-art {
        min-height: 760px;
      }

      .art-wordmark {
        left: 24px;
        top: 36px;
        right: auto;
        font-size: 3rem;
      }

      .art-bird {
        right: 26px;
        top: 150px;
        width: 56px;
      }

      .art-command {
        left: 20px;
        right: 20px;
        top: 222px;
      }

      .art-card-grid {
        left: 20px;
        right: 20px;
        top: 394px;
        bottom: auto;
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 380px) {
      .title {
        font-size: 3.4rem;
      }
    }
  </style>
</BaseLayout>
