---
import { getStaticLangPaths } from "../../i18n/routing";
import LandingPage from "../../templates/LandingPage.astro";
import type { LangCode } from "../../i18n/routing";

export function getStaticPaths() {
  const buildLang = process.env.WWDC_ARTICLE_BUILD_LANG;
  return getStaticLangPaths().filter(({ params }) => !buildLang || params.lang === buildLang);
}

const { lang } = Astro.props as { lang: LangCode };
---

<LandingPage lang={lang} />
