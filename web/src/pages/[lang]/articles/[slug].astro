---
import { getCollection, render } from "astro:content";
import { getArticleMetaDescription } from "../../../content/articles/descriptions";
import {
  getArticleSlugFromId,
  getDefaultArticleEntries,
  getLocalizedArticleEntry,
} from "../../../content/articles/localized";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { getArticlesLocale } from "../../../i18n/articles";
import { nonDefaultLangs } from "../../../i18n/routing";
import type { LangCode } from "../../../i18n/routing";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const defaultArticles = getDefaultArticleEntries(articles);
  const defaultArticlesBySlug = new Map(
    defaultArticles.map((entry) => [getArticleSlugFromId(entry.id), entry]),
  );
  const buildLang = process.env.WWDC_ARTICLE_BUILD_LANG;
  const targetLangs = nonDefaultLangs.filter((lang) => !buildLang || lang === buildLang);

  return targetLangs.flatMap((lang) => {
    const slugs = defaultArticles.length > 0
      ? defaultArticles.map((entry) => getArticleSlugFromId(entry.id))
      : articles
          .filter((entry) => entry.id.startsWith(`${lang}/`))
          .map((entry) => getArticleSlugFromId(entry.id));

    return slugs.flatMap((slug) => {
      const entry = getLocalizedArticleEntry(articles, slug, lang) ?? defaultArticlesBySlug.get(slug);
      if (!entry) return [];

      return {
        params: { lang, slug },
        props: {
          entry,
          articleSlug: `${lang}/${slug}`,
          lang,
        },
      };
    });
  });
}

const { entry, articleSlug, lang } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<"articles">>>[number];
  articleSlug: string;
  lang: LangCode;
};
const { Content } = await render(entry);
const description = getArticleMetaDescription(
  entry.data.description,
  entry.body,
  lang,
  getArticlesLocale(lang).documentDescription,
);
---

<ArticleLayout
  title={entry.data.title}
  description={description}
  date={entry.data.date}
  tags={entry.data.tags}
  thumbnail={entry.data.thumbnail}
  videoUrl={entry.data.videoUrl}
  articleSlug={articleSlug}
  lang={lang}
>
  <Content />
</ArticleLayout>
