---
import { getCollection, render } from "astro:content";
import {
  getArticleSlugFromId,
  getDefaultArticleEntries,
  getLocalizedArticleEntry,
} from "../../../content/articles/localized";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { nonDefaultLangs } from "../../../i18n/routing";
import type { LangCode } from "../../../i18n/routing";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const defaultArticles = getDefaultArticleEntries(articles);

  return nonDefaultLangs.flatMap((lang) =>
    defaultArticles.map((defaultEntry) => {
      const slug = getArticleSlugFromId(defaultEntry.id);
      return {
        params: { lang, slug },
        props: {
          entry: getLocalizedArticleEntry(articles, slug, lang) ?? defaultEntry,
          articleSlug: `${lang}/${slug}`,
          lang,
        },
      };
    }),
  );
}

const { entry, articleSlug, lang } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<"articles">>>[number];
  articleSlug: string;
  lang: LangCode;
};
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  thumbnail={entry.data.thumbnail}
  videoUrl={entry.data.videoUrl}
  articleSlug={articleSlug}
  lang={lang}
>
  <Content />
</ArticleLayout>
