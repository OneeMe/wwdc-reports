---
import { getCollection, render } from "astro:content";
import { getArticleDescription } from "../../content/articles/descriptions";
import { getDefaultArticleEntries } from "../../content/articles/localized";
import { getArticlesLocale } from "../../i18n/articles";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { defaultLang } from "../../i18n/routing";

export async function getStaticPaths() {
  const buildLang = process.env.WWDC_ARTICLE_BUILD_LANG;
  if (buildLang && buildLang !== defaultLang) return [];

  const articles = await getCollection("articles");
  return getDefaultArticleEntries(articles).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = getArticleDescription(
  entry.data.description,
  entry.body,
  defaultLang,
  getArticlesLocale(defaultLang).documentDescription,
);
---

<ArticleLayout
  title={entry.data.title}
  description={description}
  date={entry.data.date}
  tags={entry.data.tags}
  thumbnail={entry.data.thumbnail}
  videoUrl={entry.data.videoUrl}
  articleSlug={entry.id}
  lang={defaultLang}
>
  <Content />
</ArticleLayout>
