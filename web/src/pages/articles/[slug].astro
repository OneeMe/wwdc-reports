---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { thumbnailUuids } from "../../content/sessions/data";
import { resolveSessionThumbnailUrl } from "../../content/sessions/thumbnails";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const resolveThumbnailUrl = (thumbnail: string | undefined) =>
  resolveSessionThumbnailUrl(thumbnail, thumbnailUuids);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  thumbnail={resolveThumbnailUrl(entry.data.thumbnail)}
  videoUrl={entry.data.videoUrl}
>
  <Content />
</ArticleLayout>
