---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="wwdc-quick-look · 落地页"
  description="wwdc-quick-look 是一个 skills.sh 技能，安装后在提示词里即可查询 WWDC 课程与资源。"
>
  <section class="hero" aria-labelledby="pageTitle">
    <div class="hero-copy">
      <p class="kicker" data-i18n="kicker">SwiftGGTeam 技能</p>
      <h1 class="title" id="pageTitle" data-i18n="title">wwdc-quick-look</h1>
      <p class="subtitle" data-i18n="subtitle">
        一条命令安装到你的 Agent。之后直接用提示词检索 WWDC 课程、资源链接、代码片段和逐字稿。
      </p>

      <div class="hero-actions">
        <a class="button button-star" href="https://github.com/SwiftGGTeam/wwdc-quick-look" target="_blank" rel="noreferrer">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path fill="currentColor" d="M8 .25a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.36c-2.23.49-2.7-.95-2.7-.95-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.22.83 1.22.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.58.82-2.14-.08-.2-.36-1.02.08-2.11 0 0 .67-.22 2.2.82A7.66 7.66 0 0 1 8 4.78c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.09.16 1.91.08 2.11.51.56.82 1.27.82 2.14 0 3.07-1.87 3.75-3.66 3.95.29.25.54.74.54 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 .25Z" />
          </svg>
          <span data-i18n="githubStar">在 GitHub 上加星标</span>
        </a>
        <a class="button button-skill" href="https://www.skills.sh/swiftggteam/wwdc-quick-look" target="_blank" rel="noreferrer" data-i18n="installLink">
          去 skills.sh 查看
        </a>
      </div>

      <div class="install-card" aria-label="安装命令">
        <div class="install-label" data-i18n="installStep">一键安装</div>
        <code class="code" id="installCommand"></code>
      </div>
    </div>

    <div class="hero-art" aria-label="wwdc-quick-look 视觉卡片">
      <div class="art-wordmark" aria-hidden="true">
        <span>wwdc-</span><br />
        <span>quick-look</span>
      </div>
      <img class="art-bird" src="/assets/swiftgg-mark-color.svg" alt="" aria-hidden="true" />
      <div class="art-command">
        <p class="art-command-label" data-i18n="artCommandLabel">安装命令</p>
        <code class="code">npx skills add SwiftGGTeam/wwdc-quick-look</code>
      </div>
      <div class="art-card-grid" aria-hidden="true">
        <div class="art-card">
          <strong data-i18n="artCardSearchTitle">检索课程</strong>
          <span data-i18n="artCardSearchText">按主题、平台和关键词查找 WWDC 内容。</span>
        </div>
        <div class="art-card">
          <strong data-i18n="artCardResourceTitle">打开资源</strong>
          <span data-i18n="artCardResourceText">直达 Apple 文档、示例代码和相关链接。</span>
        </div>
        <div class="art-card">
          <strong data-i18n="artCardEvidenceTitle">读取依据</strong>
          <span data-i18n="artCardEvidenceText">按需提取代码标签和逐字稿行。</span>
        </div>
      </div>
    </div>
  </section>

  <section class="prompt-panel" aria-labelledby="promptTitle">
    <div class="panel-head">
      <div>
        <p class="section-label" data-i18n="promptLabel">提示词示例</p>
        <h2 class="section-title" id="promptTitle" data-i18n="promptTitle">直接询问 WWDC 档案。</h2>
      </div>
      <p class="muted" data-i18n="promptIntro">安装完成后，在支持技能的聊天环境里直接发这些提示词：</p>
    </div>
    <ol class="prompt-list" id="promptExamples"></ol>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
      gap: 54px;
      align-items: center;
      min-height: calc(100vh - 88px);
      padding: 70px 0 58px;
    }

    .kicker {
      margin: 0 0 20px;
      color: var(--blue);
      font-size: 0.82rem;
      font-weight: 820;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .title {
      max-width: 680px;
      margin: 0;
      font-size: clamp(4.1rem, 8vw, 7.6rem);
      line-height: 0.84;
      font-weight: 920;
      letter-spacing: -0.035em;
    }

    .title .blue {
      display: block;
      color: var(--blue);
    }

    .title .orange {
      color: var(--orange);
    }

    .subtitle {
      max-width: 650px;
      margin: 30px 0 0;
      color: #343842;
      font-size: 1.18rem;
      line-height: 1.75;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 50px;
      padding: 0 18px;
      border: 1px solid var(--ink);
      border-radius: 10px;
      color: var(--ink);
      background: var(--paper);
      font-weight: 760;
      text-decoration: none;
      box-shadow: none;
      transition:
        transform 160ms ease,
        box-shadow 160ms ease;
    }

    .button:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(11, 11, 15, 0.1);
    }

    .button-star {
      color: var(--paper);
      background: var(--ink);
    }

    .button-star svg {
      width: 20px;
      height: 20px;
    }

    .button-skill {
      border-color: var(--line-strong);
      color: #1f2733;
    }

    .install-card {
      display: grid;
      gap: 10px;
      max-width: 690px;
      margin-top: 28px;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 16px 48px rgba(39, 130, 251, 0.09);
    }

    .install-label {
      color: var(--blue);
      font-size: 0.78rem;
      font-weight: 840;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .code {
      display: block;
      min-width: 0;
      margin: 0;
      padding: 15px 16px;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 12px;
      color: #151922;
      background: #f8faff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      font-size: 0.95rem;
      line-height: 1.55;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .hero-art {
      position: relative;
      min-height: 560px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 28px;
      background:
        radial-gradient(circle at 18% 22%, rgba(251, 97, 49, 0.22), transparent 12rem),
        radial-gradient(circle at 68% 18%, rgba(39, 130, 251, 0.24), transparent 16rem),
        linear-gradient(135deg, #fff 0%, #f5f8ff 58%, #fff7f3 100%);
      box-shadow: var(--shadow);
    }

    .hero-art::before {
      position: absolute;
      inset: 26px;
      content: "";
      border: 1px solid rgba(11, 11, 15, 0.08);
      border-radius: 22px;
    }

    .art-wordmark {
      position: absolute;
      top: 50px;
      left: 44px;
      font-size: clamp(3.5rem, 7vw, 6.4rem);
      line-height: 0.8;
      font-weight: 920;
      letter-spacing: -0.05em;
    }

    .art-wordmark span:first-child {
      color: var(--blue);
    }

    .art-wordmark span:last-child {
      color: var(--orange);
    }

    .art-bird {
      position: absolute;
      right: 42px;
      top: 58px;
      width: 104px;
      height: auto;
      filter: drop-shadow(0 14px 28px rgba(39, 130, 251, 0.16));
    }

    .art-command {
      position: absolute;
      left: 44px;
      right: 44px;
      top: 232px;
      padding: 20px;
      border: 1px solid rgba(11, 11, 15, 0.1);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.76);
      box-shadow: 0 20px 50px rgba(11, 11, 15, 0.08);
    }

    .art-command-label {
      margin: 0 0 10px;
      color: var(--orange);
      font-size: 0.76rem;
      font-weight: 840;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .art-card-grid {
      position: absolute;
      left: 44px;
      right: 44px;
      bottom: 44px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .art-card {
      min-height: 104px;
      padding: 16px;
      border: 1px solid rgba(11, 11, 15, 0.09);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.64);
    }

    .art-card strong {
      display: block;
      margin-bottom: 8px;
      font-size: 0.92rem;
    }

    .art-card span {
      color: var(--slate);
      font-size: 0.84rem;
      line-height: 1.48;
    }

    .prompt-panel {
      border-top: 1px solid var(--line);
      padding-top: 54px;
    }

    .panel-head {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(280px, 1fr);
      gap: 44px;
      align-items: end;
    }

    .section-label {
      margin: 0 0 14px;
      color: var(--blue);
      font-size: 0.82rem;
      font-weight: 840;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .section-title {
      margin: 0;
      font-size: clamp(2.6rem, 5vw, 4.6rem);
      line-height: 0.92;
      font-weight: 900;
      letter-spacing: -0.035em;
    }

    .muted {
      margin: 0;
      color: #3d424d;
      font-size: 1.04rem;
      line-height: 1.72;
    }

    .prompt-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin: 32px 0 0;
      padding: 0;
      list-style: none;
    }

    .prompt-item {
      min-width: 0;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--paper);
      box-shadow: 0 14px 38px rgba(11, 11, 15, 0.06);
    }

    .prompt-label {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      margin: 0 0 14px;
      color: var(--orange);
      font-size: 0.78rem;
      font-weight: 840;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .prompt-item .code {
      min-height: 164px;
    }

    @media (max-width: 980px) {
      .hero {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-art {
        min-height: 520px;
      }

      .panel-head,
      .prompt-list {
        grid-template-columns: 1fr;
      }

      .prompt-item .code {
        min-height: auto;
      }
    }

    @media (max-width: 640px) {
      .hero {
        gap: 34px;
        padding-top: 40px;
      }

      .title {
        font-size: 4.2rem;
      }

      .hero-actions,
      .button {
        width: 100%;
      }

      .hero-art {
        min-height: 760px;
      }

      .art-wordmark {
        left: 24px;
        top: 36px;
        font-size: 4rem;
      }

      .art-bird {
        right: 26px;
        top: 132px;
        transform: scale(0.72);
        transform-origin: top right;
      }

      .art-command {
        left: 20px;
        right: 20px;
        top: 222px;
      }

      .art-card-grid {
        left: 20px;
        right: 20px;
        top: 394px;
        bottom: auto;
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
