---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面未找到 · WWDC Quick Look"
  description="请求的页面不存在。返回 WWDC Quick Look 继续浏览 Apple 开发者课程。"
  noindex
  section="home"
>
  <section class="not-found" aria-labelledby="notFoundTitle">
    <p class="eyebrow">404 · PAGE NOT FOUND</p>
    <h1 id="notFoundTitle">这个页面不在归档里。</h1>
    <p>链接可能已经失效，或地址输入有误。你可以返回首页，继续查询 WWDC sessions 与技术文章。</p>
    <div class="actions">
      <a class="primary-action" href="/">返回首页</a>
      <a class="secondary-action" href="/articles/">浏览 Session</a>
    </div>
  </section>

  <style>
    .not-found {
      width: min(760px, 100%);
      margin: 96px auto 32px;
      padding: 72px;
      border: 1px solid rgba(228, 231, 238, 0.94);
      border-radius: 32px;
      background:
        radial-gradient(circle at 15% 8%, rgba(251, 97, 49, 0.14), transparent 17rem),
        radial-gradient(circle at 88% 94%, rgba(39, 130, 251, 0.16), transparent 20rem),
        rgba(255, 255, 255, 0.86);
      box-shadow: var(--shadow);
      text-align: center;
    }

    .eyebrow {
      margin: 0 0 20px;
      color: var(--blue);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.14em;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.2rem, 6vw, 4.4rem);
      font-weight: 850;
      letter-spacing: -0.055em;
      line-height: 0.98;
    }

    .not-found > p:not(.eyebrow) {
      max-width: 560px;
      margin: 28px auto 0;
      color: var(--slate);
      font-size: 1.06rem;
      line-height: 1.7;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      margin-top: 34px;
    }

    .actions a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 20px;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 750;
      text-decoration: none;
    }

    .primary-action {
      background: var(--ink);
      color: white;
      box-shadow: 0 12px 26px rgba(11, 11, 15, 0.18);
    }

    .secondary-action {
      border: 1px solid var(--line-strong);
      background: white;
      color: var(--ink);
    }

    @media (max-width: 640px) {
      .not-found {
        margin-top: 48px;
        padding: 48px 24px;
        border-radius: 24px;
      }
    }
  </style>
</BaseLayout>
