---
import { articlesDefaultLang } from "../i18n/articles";
import type { ArticlesLangCode } from "../i18n/articles";
import type { GoogleAdsenseConfig } from "../config/adsense";

interface Props {
  config: GoogleAdsenseConfig;
  lang?: ArticlesLangCode;
}

const { config, lang = articlesDefaultLang } = Astro.props;
const label: Record<ArticlesLangCode, string> = {
  zh: "广告",
  en: "Advertisement",
  ja: "広告",
};
---

{config.enabled && (
  <aside class="ad-slot" aria-label={label[lang]}>
    <span class="ad-slot__label">{label[lang]}</span>
    <script
      async
      crossorigin="anonymous"
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${config.client}`}
    ></script>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={config.client}
      data-ad-slot={config.articleSlot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
)}

<style>
  .ad-slot {
    width: 100%;
    min-height: 90px;
    margin: 48px 0;
    overflow: hidden;
    text-align: center;
  }

  .ad-slot__label {
    display: block;
    margin-bottom: 8px;
    color: var(--slate);
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
