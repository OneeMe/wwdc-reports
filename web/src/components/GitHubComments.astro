---
interface Props {
  articleSlug: string;
  articleTitle: string;
  articleUrl: string;
}

const { articleSlug, articleTitle, articleUrl } = Astro.props;
---

<section
  class="github-comments"
  data-github-comments
  data-article-slug={articleSlug}
  data-article-title={articleTitle}
  data-article-url={articleUrl}
  aria-labelledby={`comments-${articleSlug}`}
>
  <div class="comments-heading-row">
    <div>
      <h2 id={`comments-${articleSlug}`} class="comments-title">评论</h2>
      <p class="comments-meta" data-comments-meta>GitHub Issues</p>
    </div>
    <a class="comments-issue-link" data-issue-link href="#" target="_blank" rel="noreferrer" hidden>GitHub Issue</a>
  </div>

  <div class="comments-alert" data-comments-alert hidden></div>
  <div class="comments-loading" data-comments-loading>加载评论中...</div>

  <ol class="comments-list" data-comments-list></ol>

  <form class="comment-form" data-comment-form hidden>
    <div class="comment-user-row">
      <img class="comment-user-avatar" data-user-avatar src="" alt="" hidden />
      <span class="comment-user-name" data-user-name></span>
      <button class="comment-logout" type="button" data-logout-button>退出</button>
    </div>

    <div class="comment-selection" data-selection-box hidden>
      <div class="comment-selection-label">引用</div>
      <blockquote data-selection-text></blockquote>
      <button type="button" data-selection-clear aria-label="清除引用">×</button>
    </div>

    <label class="sr-only" for={`comment-body-${articleSlug}`}>评论内容</label>
    <textarea id={`comment-body-${articleSlug}`} data-comment-body rows="5" maxlength="5000" placeholder="写下你的想法"></textarea>

    <div class="comment-actions">
      <span class="comment-status" data-comment-status></span>
      <button class="comment-submit" type="submit">发布评论</button>
    </div>
  </form>

  <div class="comments-login" data-comments-login hidden>
    <button class="comments-login-button" type="button" data-login-button>使用 GitHub 登录</button>
  </div>
</section>

<button class="comment-quote-tooltip" type="button" data-quote-tooltip hidden>引用评论</button>

<script>
  const COMMENT_ROOT_SELECTOR = "[data-github-comments]";

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  async function fetchJson(url, options) {
    const response = await fetch(url, {
      credentials: "same-origin",
      ...options,
      headers: {
        "content-type": "application/json",
        ...(options?.headers || {}),
      },
    });
    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(data?.error?.message || `Request failed with ${response.status}`);
    }

    return data;
  }

  function formatDate(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";

    return new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(date);
  }

  function renderComment(comment) {
    const item = document.createElement("li");
    item.className = "comment-item";

    const bodyHtml = comment.bodyHtml || `<p>${escapeHtml(comment.body).replace(/\n/g, "<br />")}</p>`;
    const avatar = comment.user?.avatarUrl ? `<img class="comment-avatar" src="${escapeHtml(comment.user.avatarUrl)}" alt="" loading="lazy" />` : "";
    const login = escapeHtml(comment.user?.login || "GitHub User");
    const profileUrl = escapeHtml(comment.user?.htmlUrl || "#");
    const commentUrl = escapeHtml(comment.htmlUrl || "#");
    const createdAt = escapeHtml(formatDate(comment.createdAt));

    item.innerHTML = `
      <article class="comment-card">
        <header class="comment-card-header">
          <a class="comment-author" href="${profileUrl}" target="_blank" rel="noreferrer">
            ${avatar}
            <span>${login}</span>
          </a>
          <a class="comment-time" href="${commentUrl}" target="_blank" rel="noreferrer">${createdAt}</a>
        </header>
        <div class="comment-body">${bodyHtml}</div>
      </article>
    `;

    return item;
  }

  function selectedArticleSelection(root) {
    const selection = window.getSelection();
    if (!selection || selection.isCollapsed || selection.rangeCount === 0) return null;

    const article = root.closest(".article-container");
    const content = article?.querySelector(".article-content");
    if (!content) return null;

    const anchorNode = selection.anchorNode;
    const focusNode = selection.focusNode;
    if (!anchorNode || !focusNode || !content.contains(anchorNode) || !content.contains(focusNode)) {
      return null;
    }

    const text = selection.toString().replace(/\s+/g, " ").trim().slice(0, 800);
    if (!text) return null;

    return {
      text,
      rect: selection.getRangeAt(0).getBoundingClientRect(),
    };
  }

  function initComments(root) {
    const slug = root.dataset.articleSlug;
    const articleTitle = root.dataset.articleTitle;
    const articleUrl = root.dataset.articleUrl;
    const loading = root.querySelector("[data-comments-loading]");
    const alert = root.querySelector("[data-comments-alert]");
    const meta = root.querySelector("[data-comments-meta]");
    const list = root.querySelector("[data-comments-list]");
    const loginBox = root.querySelector("[data-comments-login]");
    const loginButton = root.querySelector("[data-login-button]");
    const form = root.querySelector("[data-comment-form]");
    const textarea = root.querySelector("[data-comment-body]");
    const status = root.querySelector("[data-comment-status]");
    const submit = root.querySelector(".comment-submit");
    const issueLink = root.querySelector("[data-issue-link]");
    const userAvatar = root.querySelector("[data-user-avatar]");
    const userName = root.querySelector("[data-user-name]");
    const logoutButton = root.querySelector("[data-logout-button]");
    const selectionBox = root.querySelector("[data-selection-box]");
    const selectionText = root.querySelector("[data-selection-text]");
    const selectionClear = root.querySelector("[data-selection-clear]");
    const quoteTooltip = document.querySelector("[data-quote-tooltip]");
    let config = null;
    let session = null;
    let quote = "";
    let pendingQuote = "";
    let selectionTimer = null;

    function setAlert(message) {
      if (!alert) return;
      alert.hidden = !message;
      alert.textContent = message || "";
    }

    function setQuote(value) {
      quote = value;
      if (!selectionBox || !selectionText) return;
      selectionBox.hidden = !quote;
      selectionText.textContent = quote;
    }

    function hideQuoteTooltip() {
      pendingQuote = "";
      if (!quoteTooltip) return;
      quoteTooltip.hidden = true;
      quoteTooltip.style.removeProperty("--quote-tooltip-x");
      quoteTooltip.style.removeProperty("--quote-tooltip-y");
    }

    function showQuoteTooltip(selection) {
      if (!quoteTooltip || !selection?.rect) return;

      const { rect } = selection;
      const x = Math.min(Math.max(rect.left + rect.width / 2, 74), window.innerWidth - 74);
      const y = Math.max(rect.top - 12, 14);

      pendingQuote = selection.text;
      quoteTooltip.style.setProperty("--quote-tooltip-x", `${x}px`);
      quoteTooltip.style.setProperty("--quote-tooltip-y", `${y}px`);
      quoteTooltip.hidden = false;
    }

    function renderSession() {
      const authenticated = Boolean(session?.authenticated);

      if (loginBox) loginBox.hidden = authenticated || !config?.enabled;
      if (form) form.hidden = !authenticated;

      if (authenticated && session.user) {
        if (userAvatar && session.user.avatarUrl) {
          userAvatar.src = session.user.avatarUrl;
          userAvatar.hidden = false;
        }
        if (userName) userName.textContent = `@${session.user.login}`;
      }
    }

    function renderComments(data) {
      if (!list || !meta) return;
      const comments = data.comments || [];
      list.replaceChildren(...comments.map(renderComment));
      meta.textContent = `${comments.length} 条评论`;

      if (issueLink && data.issue?.htmlUrl) {
        issueLink.href = data.issue.htmlUrl;
        issueLink.hidden = false;
      }

      if (comments.length === 0) {
        const empty = document.createElement("li");
        empty.className = "comments-empty";
        empty.textContent = "暂无评论";
        list.append(empty);
      }
    }

    async function load() {
      try {
        setAlert("");
        if (loading) loading.hidden = false;

        config = await fetchJson("/api/comments/config");
        if (!config.enabled) {
          setAlert("评论系统尚未配置");
          return;
        }

        const [sessionData, commentsData] = await Promise.all([
          fetchJson("/api/comments/session"),
          fetchJson(`/api/comments/${encodeURIComponent(slug)}`),
        ]);
        session = sessionData;
        renderSession();
        renderComments(commentsData);
      } catch (error) {
        setAlert(error.message || "评论加载失败");
      } finally {
        if (loading) loading.hidden = true;
      }
    }

    loginButton?.addEventListener("click", () => {
      const returnTo = `${window.location.pathname}${window.location.search}${window.location.hash}`;
      window.location.href = `${config?.loginUrl || "/api/comments/auth/login"}?returnTo=${encodeURIComponent(returnTo)}`;
    });

    logoutButton?.addEventListener("click", async () => {
      try {
        await fetchJson("/api/comments/logout", { method: "POST", body: "{}" });
        session = { authenticated: false };
        renderSession();
      } catch (error) {
        setAlert(error.message || "退出失败");
      }
    });

    selectionClear?.addEventListener("click", () => {
      setQuote("");
      hideQuoteTooltip();
      window.getSelection()?.removeAllRanges();
    });

    quoteTooltip?.addEventListener("pointerdown", (event) => {
      event.preventDefault();
    });

    quoteTooltip?.addEventListener("click", () => {
      if (!pendingQuote) return;
      setQuote(pendingQuote);
      hideQuoteTooltip();
      window.getSelection()?.removeAllRanges();
      root.scrollIntoView({ behavior: "smooth", block: "start" });

      if (textarea && !form?.hidden) {
        window.setTimeout(() => textarea.focus(), 260);
      } else if (!session?.authenticated) {
        setAlert(config?.enabled ? "登录 GitHub 后可发布引用评论" : "评论系统尚未配置");
      }
    });

    document.addEventListener("selectionchange", () => {
      window.clearTimeout(selectionTimer);
      selectionTimer = window.setTimeout(() => {
        const selection = selectedArticleSelection(root);
        if (selection) {
          showQuoteTooltip(selection);
        } else if (!quoteTooltip?.matches(":hover")) {
          hideQuoteTooltip();
        }
      }, 80);
    });

    document.addEventListener("scroll", hideQuoteTooltip, { passive: true });
    window.addEventListener("resize", hideQuoteTooltip);

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const body = textarea?.value.trim() || "";
      if (!body) {
        textarea?.focus();
        return;
      }

      try {
        if (submit) submit.disabled = true;
        if (status) status.textContent = "发布中...";
        await fetchJson(`/api/comments/${encodeURIComponent(slug)}`, {
          method: "POST",
          body: JSON.stringify({
            body,
            selection: quote,
            articleTitle,
            articleUrl,
          }),
        });
        if (textarea) textarea.value = "";
        setQuote("");
        hideQuoteTooltip();
        if (status) status.textContent = "已发布";
        const commentsData = await fetchJson(`/api/comments/${encodeURIComponent(slug)}`);
        renderComments(commentsData);
      } catch (error) {
        setAlert(error.message || "评论发布失败");
      } finally {
        if (submit) submit.disabled = false;
        window.setTimeout(() => {
          if (status) status.textContent = "";
        }, 1800);
      }
    });

    load();
  }

  document.querySelectorAll(COMMENT_ROOT_SELECTOR).forEach(initComments);
</script>

<style>
  .github-comments {
    margin-top: 56px;
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  .comment-quote-tooltip {
    position: fixed;
    top: var(--quote-tooltip-y, 0);
    left: var(--quote-tooltip-x, 0);
    z-index: 40;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(11, 11, 15, 0.1);
    border-radius: 8px;
    background: rgba(11, 11, 15, 0.94);
    color: white;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 740;
    line-height: 34px;
    box-shadow: 0 12px 32px rgba(11, 11, 15, 0.22);
    cursor: pointer;
    transform: translate(-50%, -100%);
  }

  .comment-quote-tooltip::after {
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    background: rgba(11, 11, 15, 0.94);
    content: "";
    transform: translateX(-50%) rotate(45deg);
  }

  .comment-quote-tooltip:hover {
    background: var(--blue);
  }

  .comment-quote-tooltip:hover::after {
    background: var(--blue);
  }

  .comments-heading-row,
  .comment-user-row,
  .comment-actions,
  .comment-card-header {
    display: flex;
    align-items: center;
  }

  .comments-heading-row {
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 20px;
  }

  .comments-title {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 1.3rem;
    font-weight: 760;
    line-height: 1.25;
  }

  .comments-meta,
  .comment-status {
    margin: 0;
    color: var(--slate);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .comments-issue-link,
  .comment-logout {
    border: 0;
    background: transparent;
    color: var(--blue);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 680;
    text-decoration: none;
    cursor: pointer;
  }

  .comments-alert,
  .comments-loading,
  .comments-empty {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.68);
    color: var(--slate);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .comments-alert {
    border-color: rgba(251, 97, 49, 0.32);
    background: rgba(251, 97, 49, 0.07);
    color: #9a3a1d;
  }

  .comments-list {
    display: grid;
    gap: 14px;
    margin: 18px 0 24px;
    padding: 0;
    list-style: none;
  }

  .comment-card {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
  }

  .comment-card-header {
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .comment-author {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 9px;
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 720;
    text-decoration: none;
  }

  .comment-avatar,
  .comment-user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--mist);
  }

  .comment-time {
    flex: 0 0 auto;
    color: var(--slate);
    font-size: 0.82rem;
    font-weight: 620;
    text-decoration: none;
  }

  .comment-body {
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .comment-body p {
    margin: 0 0 12px;
  }

  .comment-body p:last-child {
    margin-bottom: 0;
  }

  .comment-body blockquote {
    margin: 0 0 14px;
    padding: 10px 14px;
    border-left: 3px solid var(--line-strong);
    color: var(--slate);
    background: rgba(11, 11, 15, 0.035);
  }

  .comments-login {
    display: flex;
    justify-content: flex-start;
  }

  .comments-login-button,
  .comment-submit {
    min-height: 40px;
    border: 0;
    border-radius: 8px;
    background: var(--ink);
    color: white;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 760;
    cursor: pointer;
    transition: background 160ms ease, transform 160ms ease;
  }

  .comments-login-button {
    padding: 0 16px;
  }

  .comment-submit {
    padding: 0 18px;
  }

  .comments-login-button:hover,
  .comment-submit:hover {
    background: var(--blue);
    transform: translateY(-1px);
  }

  .comment-submit:disabled {
    cursor: wait;
    opacity: 0.62;
    transform: none;
  }

  .comment-form {
    display: grid;
    gap: 14px;
  }

  .comment-user-row {
    gap: 9px;
    color: var(--ink);
    font-size: 0.94rem;
    font-weight: 700;
  }

  .comment-logout {
    margin-left: auto;
  }

  .comment-selection {
    position: relative;
    padding: 13px 42px 13px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(11, 11, 15, 0.035);
  }

  .comment-selection-label {
    margin-bottom: 6px;
    color: var(--slate);
    font-size: 0.78rem;
    font-weight: 760;
  }

  .comment-selection blockquote {
    margin: 0;
    color: var(--ink);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .comment-selection button {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: rgba(11, 11, 15, 0.08);
    color: var(--ink);
    cursor: pointer;
  }

  .comment-form textarea {
    width: 100%;
    min-height: 128px;
    resize: vertical;
    padding: 13px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
    color: var(--ink);
    font: inherit;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .comment-form textarea:focus {
    border-color: var(--blue);
    outline: 3px solid rgba(39, 130, 251, 0.16);
  }

  .comment-actions {
    justify-content: space-between;
    gap: 14px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .comments-heading-row,
    .comment-card-header,
    .comment-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .comment-submit,
    .comments-login-button {
      width: 100%;
    }
  }
</style>
