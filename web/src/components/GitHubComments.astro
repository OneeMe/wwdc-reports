---
import { articlesDefaultLang, getArticlesLocale } from "../i18n/articles";
import type { ArticlesLangCode } from "../i18n/articles";

interface Props {
  articleSlug: string;
  lang?: ArticlesLangCode;
}

const { articleSlug, lang = articlesDefaultLang } = Astro.props;
const copy = getArticlesLocale(lang);
const commentsId = `comments-${articleSlug}`;
const utterancesRepo = "SwiftGGTeam/wwdc-quick-look";
const utterancesLabel = "article-comment";
---

<section class="github-comments" aria-labelledby={commentsId}>
  <div class="comments-heading-row">
    <div>
      <h2 id={commentsId} class="comments-title">{copy.commentsTitle}</h2>
      <p class="comments-meta">GitHub Issues · utterances</p>
    </div>
  </div>

  <div class="utterances-shell">
    <script
      is:inline
      src="https://utteranc.es/client.js"
      repo={utterancesRepo}
      issue-term={articleSlug}
      label={utterancesLabel}
      theme="github-light"
      crossorigin="anonymous"
      async
    ></script>
  </div>
</section>

<style>
  .github-comments {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .comments-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .comments-title {
    margin: 0;
    color: var(--ink);
    font-size: 1.32rem;
    font-weight: 760;
    line-height: 1.2;
  }

  .comments-meta {
    margin: 6px 0 0;
    color: var(--slate);
    font-size: 0.88rem;
    font-weight: 520;
    line-height: 1.45;
  }

  .utterances-shell {
    min-height: 180px;
  }

  .utterances-shell :global(.utterances) {
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .github-comments {
      margin-top: 40px;
      padding-top: 26px;
    }

    .comments-title {
      font-size: 1.18rem;
    }
  }
</style>
