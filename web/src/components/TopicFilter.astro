---
import { topics, sessions } from "../content/sessions/data";
import { articlesDefaultLang, getArticlesLocale } from "../i18n/articles";
import type { ArticlesLangCode } from "../i18n/articles";

interface Props {
  lang?: ArticlesLangCode;
}

const { lang = articlesDefaultLang } = Astro.props;
const t = getArticlesLocale(lang);

const topicCounts = topics.map((topic) => ({
  ...topic,
  count: sessions.filter((s) => s.primaryTopic === topic.id).length,
}));
---

<div class="filter-section">
  <div class="filter-title">{t.filterTopic}</div>
  <div class="filter-group" id="topicFilters">
    <label class="filter-item active" data-topic="all">
      <input type="radio" name="topic" value="all" checked />
      <span class="filter-label">{t.filterAllTopics}</span>
      <span class="filter-count">{sessions.length}</span>
    </label>
    {topicCounts.map((topic) => (
      <label class="filter-item" data-topic={topic.id}>
        <input type="radio" name="topic" value={topic.id} />
        <span class="filter-label">{topic.title}</span>
        <span class="filter-count">{topic.count}</span>
      </label>
    ))}
  </div>
</div>
