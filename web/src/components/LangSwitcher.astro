---

<div class="lang-switcher" aria-label="语言切换" id="langSwitcher">
  <button class="lang-btn active" data-lang-target="zh" type="button">中文</button>
  <button class="lang-btn" data-lang-target="en" type="button">EN</button>
  <button class="lang-btn" data-lang-target="ja" type="button">日本語</button>
</div>

<style>
  .lang-switcher {
    display: flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
  }

  .lang-btn {
    min-height: 34px;
    border: 0;
    border-radius: 8px;
    padding: 0 13px;
    color: var(--slate);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
  }

  .lang-btn.active {
    color: var(--paper);
    background: var(--ink);
  }
</style>

<script>
  import { localeData, defaultLang } from "../i18n/landing";
  import type { LangCode } from "../i18n/landing";

  const STORAGE_KEY = "wql-lang";

  function readStoredLang(): LangCode {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored && localeData[stored]) return stored as LangCode;
    } catch {
      /* localStorage unavailable */
    }
    return defaultLang;
  }

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function setLang(lang: LangCode, persist = true) {
    const finalLang = localeData[lang] ? lang : defaultLang;
    const data = localeData[finalLang];

    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, finalLang);
      } catch {
        /* localStorage unavailable */
      }
    }

    const els = document.querySelectorAll<HTMLElement>("[data-i18n]");
    els.forEach((el) => {
      const key = el.dataset.i18n;
      if (!key) return;
      const value = data[key as keyof typeof data];
      if (typeof value === "string") {
        if (key === "title") {
          const [first, second] = value.split("|");
          if (second) {
            el.innerHTML = `${escapeHtml(first)}<span class="blue">${escapeHtml(second)}</span>`;
          } else {
            el.textContent = first;
          }
        } else {
          el.textContent = value;
        }
      }
    });

    const installCommandEl = document.getElementById("installCommand");
    if (installCommandEl) installCommandEl.textContent = data.installCmd;

    // Update the existing (Astro-scoped) prompt items in place — replacing
    // innerHTML would drop the data-astro-cid attribute and lose the card styles.
    const promptItems = document.querySelectorAll("#promptExamples .prompt-item");
    data.prompts.forEach((item, i) => {
      const li = promptItems[i];
      if (!li) return;
      const label = li.querySelector(".prompt-label");
      const code = li.querySelector(".code");
      if (label) label.textContent = item.label;
      if (code) code.textContent = item.text;
    });

    document.documentElement.lang = finalLang === "zh" ? "zh-CN" : finalLang;

    document.querySelectorAll("[data-lang-target]").forEach((btn) => {
      btn.classList.toggle("active", btn.getAttribute("data-lang-target") === finalLang);
    });

    // Let other components (e.g. the articles browser) react to the change.
    window.dispatchEvent(new CustomEvent("langchange", { detail: { lang: finalLang } }));
  }

  document.querySelectorAll("[data-lang-target]").forEach((button) => {
    button.addEventListener("click", () => {
      const lang = button.getAttribute("data-lang-target") as LangCode;
      setLang(lang);
    });
  });

  setLang(readStoredLang(), false);
</script>
