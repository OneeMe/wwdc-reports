---
import {
  getHtmlLang,
  getLocalizedPath,
  langLabels,
  stripLangPrefix,
  supportedLangs,
} from "../i18n/routing";
import type { LangCode } from "../i18n/routing";

interface Props {
  lang: LangCode;
  pathname?: string;
  search?: string;
  label?: string;
}

const {
  lang,
  pathname = Astro.url.pathname,
  search = Astro.url.search,
  label = "Language",
} = Astro.props;

const basePath = stripLangPrefix(pathname);
---

<div class="lang-switcher" aria-label={label}>
  {supportedLangs.map((targetLang) => (
    <a
      class:list={["lang-btn", { active: targetLang === lang }]}
      href={`${getLocalizedPath(basePath, targetLang)}${search}`}
      hreflang={getHtmlLang(targetLang)}
      aria-current={targetLang === lang ? "true" : undefined}
    >
      {langLabels[targetLang]}
    </a>
  ))}
</div>

<style>
  .lang-switcher {
    display: flex;
    flex: 0 0 auto;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    border-radius: 8px;
    padding: 0 12px;
    color: var(--slate);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-btn:hover {
    color: var(--ink);
    background: rgba(11, 11, 15, 0.04);
  }

  .lang-btn.active {
    color: var(--paper);
    background: var(--ink);
  }
</style>
